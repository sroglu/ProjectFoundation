/* PhotoAlbum layout (Papercut). */

.pc-photo-album-thumbnail {
    width: 120px;
    height: 120px;
    margin: 6px;
    background-color: rgba(255, 255, 255, 0.55);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--pc-primary-edge);
    overflow: hidden;
}

.pc-photo-album-viewer-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.88);
    align-items: center;
    justify-content: center;
}

.pc-photo-album-viewer-image {
    width: 80%;
    height: 70%;
    background-color: rgb(60, 30, 30);
    border-radius: 14px;
    margin-bottom: 16px;
}

.pc-photo-album-viewer-info {
    align-items: center;
    margin-bottom: 16px;
}

.pc-photo-album-viewer-game-tag {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16px;
}

.pc-photo-album-viewer-date {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    margin-top: 4px;
}

.pc-photo-album-viewer-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 52px;
    height: 52px;
    /* Floating close icon — opts out of .pc-button 88×88 default
       so the close glyph stays a small corner control. */
    min-width: auto;
    min-height: auto;
    align-items: center;
    justify-content: center;
}

.pc-photo-album-viewer-close > .pc-highlight {
    width: 16px;
    height: 16px;
}

.pc-photo-album-viewer-toolbar {
    flex-direction: row;
    justify-content: center;
}
